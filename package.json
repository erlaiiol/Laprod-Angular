{
  "name": "laprod-angular",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:mobile": "ng build --configuration=mobile",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "cap:sync": "npx cap sync",
    "cap:ios": "npm run build:mobile && npx cap sync ios && npx cap open ios",
    "cap:android": "npm run build:mobile && npx cap sync android && npx cap open android",
    "dev:ios": "./scripts/dev-ios.sh",
    "dev:ios:live": "./scripts/dev-ios-livereload.sh",
    "dev:android": "./scripts/dev-android.sh",
    "dev:android:live": "./scripts/dev-android-livereload.sh"
  },
  "private": true,
  "packageManager": "npm@11.12.0",
  "dependencies": {
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.17",
    "@angular/compiler": "^21.2.17",
    "@angular/core": "^21.2.17",
    "@angular/forms": "^21.2.17",
    "@angular/platform-browser": "^21.2.17",
    "@angular/router": "^21.2.17",
    "@breezystack/lamejs": "^1.2.7",
    "@capacitor-community/safe-area": "^8.0.1",
    "@capacitor/android": "^8.4.1",
    "@capacitor/app": "^8.1.0",
    "@capacitor/browser": "^8.0.3",
    "@capacitor/core": "^8.4.1",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.4.1",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/push-notifications": "^8.1.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/space-grotesk": "^5.2.10",
    "bootstrap": "^5.3.0",
    "bootstrap-icons": "^1.11.0",
    "chart.js": "^4.5.1",
    "ng2-charts": "^10.0.0",
    "pitchy": "^4.1.0",
    "rxjs": "~7.8.0",
    "soundtouchjs": "^0.3.0",
    "tslib": "^2.3.0",
    "wavesurfer.js": "^7.12.5"
  },
